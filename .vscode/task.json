{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🔥 Улучшить весь проект (3 ИИ + агент)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\debate.ps1",
                "-question",
                "Проанализируй весь проект. Найди все ошибки, улучши код, сделай его идеальным. Примени изменения ко всем файлам.",
                "-filePath",
                "."
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            },
            "problemMatcher": []
        }
    ]
}