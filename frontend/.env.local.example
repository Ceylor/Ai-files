# URL бэкенда FastAPI (используется для проксирования API).
# Если бэкенд запущен не на 127.0.0.1:8000 — укажите свой адрес.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Базовый URL для прямых ссылок на видеофайлы (опционально).
# Если указан, ссылки на скачивание клипов используют его.
NEXT_PUBLIC_FILES_URL=http://127.0.0.1:8000