# GigaChat API credentials (https://developers.sber.ru/portal)
GIGACHAT_CLIENT_ID=
GIGACHAT_AUTH_KEY=

# Pixabay API key for music search (https://pixabay.com/api/)
PIXABAY_API_KEY=

# Ollama host (optional, for local LLM)
OLLAMA_HOST=http://localhost:11434

# Database. Default: SQLite (sqlite:///./data/app.db)
# For PostgreSQL: postgresql+psycopg2://user:pass@localhost:5432/aiclip
DATABASE_URL=sqlite:///./data/app.db
